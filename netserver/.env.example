# 复制为 .env 后修改。.env 含密钥，切勿提交到代码库。

# 监听地址：建议只监听本机，由 Nginx/Caddy 反向代理并提供 HTTPS
HOST=127.0.0.1
PORT=8787

# 用于签发设备令牌的 HMAC 密钥，至少 32 个字符。生成：openssl rand -base64 48
TOKEN_SECRET=

# 令牌有效期（秒）：访问令牌 15 分钟，刷新令牌 30 天
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# 设备注册表（由 npm run add-device 维护）
DEVICES_FILE=./data/devices.json

# 大模型供应商：ernie | openai_compatible
LLM_PROVIDER=ernie

# 文心（千帆 ModelBuilder v2，OpenAI 兼容协议，Bearer bce-v3/... API Key）
ERNIE_API_KEY=
ERNIE_MODEL=ernie-4.5-turbo-32k
ERNIE_BASE_URL=https://qianfan.baidubce.com/v2
# 千帆应用 ID，可选
ERNIE_APP_ID=

# 任意 OpenAI 兼容供应商（DeepSeek / 通义 compatible-mode / 自建 vLLM 等）
# 例：DeepSeek  https://api.deepseek.com          模型 deepseek-chat
# 例：通义      https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# 成本与滥用控制
MAX_TOKENS_CAP=512
RATE_LIMIT_PER_MIN=20
DAILY_REQUEST_LIMIT=500
UPSTREAM_TIMEOUT_MS=30000
